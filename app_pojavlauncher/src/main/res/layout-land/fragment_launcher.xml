<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <TextView
        android:id="@+id/zyro_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="ZYRO"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_20ssp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/zyro_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_19sdp"
        android:text="JAVA EDITION  •  YOUR WORLD, YOUR RULES"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_7ssp"
        android:letterSpacing="0.06"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_brand" />

    <View
        android:id="@+id/zyro_accent_line"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_19sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@color/zyro_accent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_tagline" />

    <TextView
        android:id="@+id/zyro_profiles_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="PROFILES"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_accent_line" />

    <TextView
        android:id="@+id/zyro_profiles_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_19sdp"
        android:layout_marginTop="@dimen/_3sdp"
        android:text="Choose a Minecraft installation"
        android:textColor="@color/secondary_text"
        android:textSize="@dimen/_8ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_profiles_title" />

    <!-- The existing profile selector is retained so installed and newly-created profiles stay functional. -->
    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginStart="@dimen/_18sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@color/zyro_surface"
        android:drawableEnd="@drawable/spinner_arrow"
        android:drawablePadding="@dimen/_8sdp"
        android:elevation="2dp"
        android:textColor="@color/primary_text"
        app:drawableEndPadding="@dimen/_10sdp"
        app:drawableEndSize="@dimen/_12sdp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_32sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_38sdp"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Edit profile"
        android:src="@drawable/ic_edit_profile"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@id/play_button"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="@dimen/_104sdp"
        android:layout_height="@dimen/_48sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:text="@string/main_play"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <!-- Legacy Amethyst shortcuts remain in the view tree only because the existing fragment binds them.
         They are intentionally hidden and no longer appear on the ZYRO home screen. -->
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/news_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/discord_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/custom_control_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/install_jar_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/share_logs_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />
    <com.kdt.mcgui.LauncherMenuButton
        android:id="@+id/open_files_button"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>