<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/zyro_content_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.68" />

    <LinearLayout
        android:id="@+id/zyro_navigation_rail"
        android:layout_width="76dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="10dp"
        android:background="@color/background_status_bar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/progress_layout"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZYRO"
            android:textColor="@color/primary_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="30dp"
            android:layout_height="2dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="20dp"
            android:background="@color/zyro_accent" />

        <TextView
            android:id="@+id/zyro_nav_home"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="HOME"
            android:textColor="@color/zyro_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@color/zyro_surface" />

        <TextView
            android:id="@+id/zyro_nav_mods"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="MODS"
            android:textColor="@color/primary_text"
            android:textSize="9sp"
            android:letterSpacing="0.04"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/zyro_nav_shaders"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="SHADERS"
            android:textColor="@color/primary_text"
            android:textSize="8sp"
            android:letterSpacing="0.02"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/zyro_nav_resourcepacks"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="RESOURCE\nPACKS"
            android:textColor="@color/primary_text"
            android:textSize="8sp"
            android:letterSpacing="0.02"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginBottom="5dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Settings"
            android:padding="12dp"
            android:src="@drawable/ic_menu_settings"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <View
        android:id="@+id/zyro_rail_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintStart_toEndOf="@id/zyro_navigation_rail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/progress_layout" />

    <!-- Main profile area. Existing fragment host and profile actions are preserved. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/zyro_rail_divider"
        app:layout_constraintEnd_toStartOf="@id/zyro_content_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/progress_layout" />

    <!-- Account panel keeps the real account spinner and its built-in player-head preview. -->
    <TextView
        android:id="@+id/zyro_account_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="22dp"
        android:text="PLAYER ACCOUNT"
        android:textColor="@color/primary_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        app:layout_constraintStart_toStartOf="@id/zyro_content_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/zyro_account_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="5dp"
        android:text="Microsoft or offline account"
        android:textColor="@color/secondary_text"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@id/zyro_content_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_account_heading" />

    <com.kdt.mcgui.mcAccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:padding="@dimen/_10sdp"
        android:dropDownWidth="wrap_content"
        android:background="@color/zyro_surface"
        app:layout_constraintStart_toStartOf="@id/zyro_content_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zyro_account_hint" />

    <View
        android:id="@+id/zyro_account_panel_border"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/divider"
        app:layout_constraintStart_toStartOf="@id/zyro_content_split"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/progress_layout" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>